# Copy to .env for local dev. These two values are PUBLIC (they ship in the
# frontend bundle by design — unsigned uploads use no secret).
# Your Cloudinary cloud name: cloudinary.com/console → dashboard top
VITE_CLOUDINARY_CLOUD_NAME=grxcwyre
# Unsigned upload preset: Settings → Upload → Upload presets (Signing Mode: Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=Pixelyaad
